# Copy to .env and fill in. NEVER commit the real .env.

# --- Gemini (default: AI Studio API key) -----------------------------------
GEMINI_API_KEY=your-ai-studio-key-here
GEMINI_MODEL=gemini-flash-latest
# gemini-flash-latest = newest Flash (satisfies "Gemini 3.5 or newer").
# To pin an explicit version instead, use e.g. gemini-3.7-flash.

# --- To use Vertex AI instead of an API key, comment out GEMINI_API_KEY and:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Google Cloud (state) --------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_COLLECTION=referral_cases

# --- Mode ------------------------------------------------------------------
# Leave unset to auto-detect (mock when no credentials). Force with:
# MOCK_MODE=1   # offline, deterministic — safe fallback for the live demo
